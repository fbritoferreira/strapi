HOST=0.0.0.0
PORT=1337

# Dev-only secrets. Generate real ones for anything non-local:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=demoKeyOne==,demoKeyTwo==
API_TOKEN_SALT=demoApiTokenSalt
ADMIN_JWT_SECRET=demoAdminJwtSecret
TRANSFER_TOKEN_SALT=demoTransferTokenSalt
JWT_SECRET=demoJwtSecret
ENCRYPTION_KEY=demoEncryptionKey

# Optional: send email through Cloudflare instead of sendmail.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_TEST_ADDRESS=

# Used by `pnpm try-client`
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=
