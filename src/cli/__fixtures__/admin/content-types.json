{
	"data": [
		{
			"uid": "api::article.article",
			"apiID": "article",
			"schema": {
				"draftAndPublish": true,
				"displayName": "Article",
				"singularName": "article",
				"pluralName": "articles",
				"description": "",
				"kind": "collectionType",
				"collectionName": "articles",
				"visible": true,
				"pluginOptions": { "i18n": { "localized": true } },
				"attributes": {
					"title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
					"slug": { "type": "uid", "targetField": "title", "required": true },
					"body": { "type": "blocks" },
					"summary": { "type": "text" },
					"readingTime": { "type": "integer" },
					"price": { "type": "decimal" },
					"views": { "type": "biginteger" },
					"featured": { "type": "boolean", "required": true },
					"publishedOn": { "type": "date" },
					"metadata": { "type": "json" },
					"status": { "type": "enumeration", "enum": ["draft", "review", "live"], "required": true },
					"cover": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
					"gallery": { "type": "media", "multiple": true },
					"author": { "type": "relation", "relation": "manyToOne", "target": "api::author.author", "inversedBy": "articles" },
					"tags": { "type": "relation", "relation": "manyToMany", "target": "api::tag.tag" },
					"createdByUser": { "type": "relation", "relation": "oneToOne", "target": "plugin::users-permissions.user" },
					"seo": { "type": "component", "repeatable": false, "component": "shared.seo" },
					"blocks": { "type": "dynamiczone", "components": ["blocks.hero", "blocks.quote"] }
				}
			}
		},
		{
			"uid": "api::author.author",
			"apiID": "author",
			"schema": {
				"displayName": "Author",
				"singularName": "author",
				"pluralName": "authors",
				"description": "",
				"kind": "collectionType",
				"collectionName": "authors",
				"visible": true,
				"attributes": {
					"name": { "type": "string", "required": true },
					"email": { "type": "email" },
					"avatar": { "type": "media", "multiple": false },
					"articles": { "type": "relation", "relation": "oneToMany", "target": "api::article.article", "mappedBy": "author" },
					"links": { "type": "component", "repeatable": true, "component": "shared.seo" }
				}
			}
		},
		{
			"uid": "api::tag.tag",
			"apiID": "tag",
			"schema": {
				"displayName": "Tag",
				"singularName": "tag",
				"pluralName": "tags",
				"description": "",
				"kind": "collectionType",
				"collectionName": "tags",
				"visible": true,
				"attributes": {
					"label": { "type": "string", "required": true },
					"color": { "type": "string" }
				}
			}
		},
		{
			"uid": "api::homepage.homepage",
			"apiID": "homepage",
			"schema": {
				"displayName": "Homepage",
				"singularName": "homepage",
				"pluralName": "homepages",
				"description": "",
				"kind": "singleType",
				"collectionName": "homepages",
				"visible": true,
				"pluginOptions": { "i18n": { "localized": true } },
				"attributes": {
					"heading": { "type": "string", "required": true },
					"hero": { "type": "component", "repeatable": false, "component": "blocks.hero" },
					"featuredArticle": { "type": "relation", "relation": "oneToOne", "target": "api::article.article" }
				}
			}
		},
		{
			"uid": "plugin::users-permissions.role",
			"plugin": "users-permissions",
			"apiID": "role",
			"schema": {
				"displayName": "Role",
				"singularName": "role",
				"pluralName": "roles",
				"kind": "collectionType",
				"collectionName": "up_roles",
				"visible": false,
				"attributes": {
					"name": { "type": "string", "required": true },
					"type": { "type": "string" }
				}
			}
		}
	]
}
