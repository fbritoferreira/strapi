{
	"$schema": "https://jsr.io/schema/config-file.v1.json",
	"name": "@fbritoferreira/strapi",
	"version": "0.24.0",
	"license": "MIT",
	"exports": {
		".": "./dist/strapi.mjs",
		"./package.json": "./package.json"
	},
	"publish": {
		"include": [
			"dist/**/*.ts",
			"dist/**/*.js",
			"README.md",
			"MIGRATION.md",
			"LICENCE.md",
			"CHANGELOG.md",
			"package.json",
			"jsr.json"
		],
		"exclude": [
			"dist/**/*.test.ts",
			"dist/**/*.test.js",
			"dist/**/*.spec.ts",
			"dist/**/*.spec.js",
			"dist/**/*.fixture.ts",
			"dist/**/*.fixture.js",
			"bin/**/*",
			"docs/**/*"
		]
	},
	"files": [
		"dist",
		"bin",
		"README.md",
		"MIGRATION.md",
		"LICENCE.md",
		"CHANGELOG.md"
	]
}
