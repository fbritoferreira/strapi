{
	"$schema": "https://jsr.io/schema/config-file.v1.json",
	"name": "@fbritoferreira/strapi-csv-import-export",
	"version": "0.2.0",
	"license": "MIT",
	"exports": {
		"./strapi-server": "./server/src/index.ts",
		"./strapi-admin": "./admin/src/index.ts"
	},
	"publish": {
		"include": [
			"server/src/**/*.ts",
			"admin/src/**/*.ts",
			"admin/src/**/*.tsx",
			"admin/src/**/*.json",
			"README.md",
			"LICENCE.md",
			"CHANGELOG.md",
			"package.json",
			"jsr.json"
		],
		"exclude": [
			"**/*.test.ts",
			"**/*.test.tsx",
			"server/src/test"
		]
	}
}
