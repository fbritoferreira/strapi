{
  "name": "@fbritoferreira/strapi-csv-import-export",
  "version": "0.0.0",
  "private": true,
  "description": "Strapi 5 plugin to import and export collection types as CSV with column mapping and upsert",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENCE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "strapi",
    "plugin",
    "csv",
    "import",
    "export"
  ],
  "author": "Filipe Brito Ferreira <me@fbritoferreira.com>",
  "license": "MIT",
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/sdk-plugin": "^6.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "5.57.0",
    "@strapi/typescript-utils": "5.57.0",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.1.19",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  },
  "strapi": {
    "kind": "plugin",
    "name": "csv-import-export",
    "displayName": "CSV Import / Export",
    "description": "Import and export collection types as CSV"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbritoferreira/strapi.git",
    "directory": "packages/csv-import-export"
  },
  "homepage": "https://strapi.fbritoferreira.com/packages/csv-import-export/",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "papaparse": "^5.7.0"
  }
}
