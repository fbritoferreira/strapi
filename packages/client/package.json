{
  "name": "@fbritoferreira/client",
  "version": "0.24.0",
  "description": "TypeScript client for the Strapi 5 REST and GraphQL APIs: typed collections, single types, auth, uploads and custom routes, with types generated from your own schema.",
  "main": "./dist/strapi.cjs",
  "module": "./dist/strapi.mjs",
  "types": "./dist/strapi.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/strapi.d.mts",
        "default": "./dist/strapi.mjs"
      },
      "require": {
        "types": "./dist/strapi.d.cts",
        "default": "./dist/strapi.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "strapi-client": "./bin/strapi-client.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "MIGRATION.md",
    "LICENCE.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.cli.config.mts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.cli-fixture.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "jsr:check": "jsr publish --dry-run --allow-dirty",
    "package:check": "publint && attw \"$(pnpm pack --pack-destination .pack | tail -1)\""
  },
  "keywords": [
    "strapi",
    "cms",
    "client",
    "typescript",
    "api",
    "headless-cms"
  ],
  "author": "Filipe Brito Ferreira <me@fbritoferreira.com>",
  "license": "MIT",
  "homepage": "https://fbritoferreira.github.io/strapi/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbritoferreira/strapi.git"
  },
  "bugs": {
    "url": "https://github.com/fbritoferreira/strapi/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "qs": "^6.14.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@microsoft/api-extractor": "^7.59.2",
    "@types/node": "^26.6.2",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsr": "^0.14.3",
    "lint-staged": "^17.6.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,mts,js}": [
      "eslint --fix"
    ]
  }
}
