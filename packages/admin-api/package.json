{
	"name": "@fbritoferreira/strapi-admin-api",
	"version": "1.2.3",
	"description": "Plugin to manage Strapi admin users and tokens via REST API",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"strapi-server.js",
		"strapi-admin.js",
		"README.md",
		"LICENCE.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc",
		"watch": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc -p tsconfig.test.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"keywords": [
		"strapi",
		"plugin",
		"admin",
		"user-management",
		"tokens"
	],
	"author": "Filipe Brito Ferreira <me@fbritoferreira.com>",
	"license": "MIT",
	"peerDependencies": {
		"@strapi/strapi": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/koa": "^3.0.3",
		"@types/node": "^20.0.0",
		"@vitest/coverage-v8": "5.0.2",
		"eslint": "^10.11.0",
		"globals": "^17.13.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.2"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"strapi": {
		"kind": "plugin",
		"name": "admin-api"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fbritoferreira/strapi.git",
		"directory": "packages/admin-api"
	},
	"homepage": "https://strapi.fbritoferreira.com/packages/admin-api/",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"lint-staged": {
		"*.{ts,mts,js}": [
			"eslint --fix"
		]
	}
}
