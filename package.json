{
  "name": "@fbritoferreira/strapi-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for the Strapi client, admin API plugin and Cloudflare email provider",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "jsr:check": "pnpm -r jsr:check",
    "package:check": "pnpm -r package:check",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "jsr": "^0.14.3",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  },
  "packageManager": "pnpm@12.5.1"
}
