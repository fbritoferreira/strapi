{
	"name": "@fbritoferreira/strapi",
	"version": "0.17.1",
	"description": "TypeScript client for the Strapi 5 REST and GraphQL APIs: typed collections, single types, auth, uploads and custom routes, with types generated from your own schema.",
	"main": "./dist/strapi.cjs",
	"module": "./dist/strapi.mjs",
	"types": "./dist/strapi.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/strapi.d.mts",
				"default": "./dist/strapi.mjs"
			},
			"require": {
				"types": "./dist/strapi.d.cts",
				"default": "./dist/strapi.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"strapi-client": "./bin/strapi-client.mjs"
	},
	"files": [
		"dist",
		"bin",
		"README.md",
		"LICENCE.md",
		"CHANGELOG.md"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc --noEmit && vite build && vite build --config vite.cli.config.mts",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.cli-fixture.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"jsr:check": "jsr publish --dry-run --allow-dirty",
		"prepare": "husky",
		"lint-staged": "lint-staged"
	},
	"keywords": [
		"strapi",
		"cms",
		"client",
		"typescript",
		"api",
		"headless-cms"
	],
	"author": "Filipe Brito Ferreira <me@fbritoferreira.com>",
	"license": "MIT",
	"homepage": "https://github.com/fbritoferreira/strapi#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fbritoferreira/strapi.git"
	},
	"bugs": {
		"url": "https://github.com/fbritoferreira/strapi/issues"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"packageManager": "pnpm@12.5.1",
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.0",
		"@microsoft/api-extractor": "^7.59.1",
		"@types/node": "^24.13.6",
		"@types/qs": "^6.15.1",
		"@vitest/coverage-v8": "5.0.1",
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"jsr": "^0.14.3",
		"lint-staged": "^17.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vite-plugin-dts": "^5.1.1",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"qs": "^6.16.0"
	},
	"lint-staged": {
		"*.{ts,mts,js}": [
			"eslint --fix"
		]
	}
}
